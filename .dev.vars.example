# Copy this file to .dev.vars and replace the upload-password placeholder.
# Never commit .dev.vars.
#
# This is Cloudflare's official always-pass *test* secret. Vite development
# mode uses the matching public test sitekey; never deploy either test key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
UPLOAD_YAJU_PIC_SECRET=replace-with-a-long-random-upload-password
