{
  "name": "yaju-pic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "ci:build": "npm ci --progress=false && npm run format:check && npm run build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:vue && npm run typecheck:native",
    "typecheck:vue": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:native": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"worker/**/*.ts\" \"shared/**/*.ts\" \"vite.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"worker/**/*.ts\" \"shared/**/*.ts\" \"vite.config.ts\"",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check"
  },
  "dependencies": {
    "jose": "6.2.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261023.1": true
  }
}
