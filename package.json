{
  "name": "yaju-pic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck:vue && npm run typecheck:native",
    "typecheck:vue": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:native": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"worker/**/*.ts\" \"vite.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"worker/**/*.ts\" \"vite.config.ts\"",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
