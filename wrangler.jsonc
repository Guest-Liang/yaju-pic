{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaju-pic",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "yaju-pic-tool.guestliang.icu",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/upload"
    ]
  },
  "vars": {
    "CF_ACCESS_AUD": "f6cf03c3c2a60b22eea79e3be13f82fc7cf8fb00948e6433c8ce323c575073fa",
    "CF_ACCESS_TEAM_DOMAIN": "https://guestliang.cloudflareaccess.com",
    "R2_PUBLIC_BASE_URL": "https://yaju-pic.guestliang.icu",
    "SITE_TIME_ZONE": "Asia/Shanghai"
  },
  "d1_databases": [
    {
      "binding": "yaju_pic_db",
      "database_name": "yaju-pic",
      "database_id": "fecbaee0-e473-49ee-9a9c-bbab41604768"
    }
  ],
  "r2_buckets": [
    {
      "binding": "yaju_pic_r2",
      "bucket_name": "yaju"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
