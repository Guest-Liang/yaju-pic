{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaju-pic",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yaju-pic-tool.guestliang.icu",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/upload"
    ]
  },
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://yaju-pic.guestliang.icu",
    "SITE_TIME_ZONE": "Asia/Shanghai",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADVJiTpSvp2Bjq9A"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "UPLOAD_YAJU_PIC_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "yaju_pic_db",
      "database_name": "yaju-pic",
      "database_id": "fecbaee0-e473-49ee-9a9c-bbab41604768"
    }
  ],
  "r2_buckets": [
    {
      "binding": "yaju_pic_r2",
      "bucket_name": "yaju"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
